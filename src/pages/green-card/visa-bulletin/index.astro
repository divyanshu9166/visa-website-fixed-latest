---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StalenessWarning from '../../../components/StalenessWarning.astro';
import DualTerminology from '../../../components/DualTerminology.astro';
import { BULLETIN_COUNTRIES } from '../../../../scripts/lib/formsConfig.mjs';

const visaBulletinData = await getCollection('visaBulletin');

const months = [...new Set(visaBulletinData.map((d) => d.data.month))].sort().reverse();
const currentMonth = months[0] || 'No data';
const currentData = visaBulletinData.filter((d) => d.data.month === currentMonth);
const staleSince = visaBulletinData.find((d) => d.data.staleSince)?.data.staleSince;
const lastUpdatedDate = currentMonth !== 'No data' ? `${currentMonth}-01` : undefined;

const formattedMonth = currentMonth !== 'No data'
  ? new Date(`${currentMonth}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : currentMonth;

const ebData = currentData.filter((d) => d.data.category.startsWith('EB'));

function bySlug(name: string) {
  const found = BULLETIN_COUNTRIES.find((c) => c.name === name)?.slug;
  if (found) return found;
  if (name.toLowerCase().includes('india')) return 'india';
  if (name.toLowerCase().includes('china')) return 'china';
  return 'rest-of-world';
}
---

<Layout title="Visa Bulletin Tracker — Priority Dates by Country [2026]" description="Track the latest Visa Bulletin movement, Final Action Dates, and Dates for Filing for Employment-based green cards by country.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Visa Bulletin' }]} />

    <StalenessWarning
      lastUpdated={lastUpdatedDate}
      staleSince={staleSince}
      maxAgeDays={35}
      sourceName="U.S. Department of State Visa Bulletin"
      sourceUrl="https://travel.state.gov/content/travel/en/legal/visa-law0/visa-bulletin.html"
      mode="banner"
    />

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 mb-8">
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 mb-2">Visa Bulletin Tracker</h1>
        <p class="text-base sm:text-lg text-stone-600 max-w-2xl">Track priority date cutoffs and monthly movement for Employment-Based green cards by country of birth.</p>
      </div>
      <div class="flex-shrink-0 self-start md:self-end pb-1">
        <StalenessWarning
          lastUpdated={lastUpdatedDate}
          staleSince={staleSince}
          maxAgeDays={35}
          sourceName="State Dept."
          mode="badge"
        />
      </div>
    </div>

    <!-- Educational Terminology Callout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
      <div class="bg-white p-5 rounded-xl border border-stone-200">
        <DualTerminology term="final-action-date" class="w-full" />
      </div>
      <div class="bg-white p-5 rounded-xl border border-stone-200">
        <DualTerminology term="dates-for-filing" class="w-full" />
      </div>
    </div>

    <!-- Country grid -->
    <h2 class="text-lg font-bold tracking-tight text-stone-800 mb-4 pb-2 border-b border-stone-100">Browse by Country of Birth</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      {BULLETIN_COUNTRIES.map((c) => {
        const rows = ebData.filter((d) => d.data.country === c.name);
        const eb2 = rows.find((r) => r.data.category === 'EB-2');
        return (
          <a href={`/green-card/visa-bulletin/${c.slug}`} class="block bg-white border border-stone-200 rounded-xl p-5 hover:border-stone-400 group transition-colors flex flex-col h-full">
            <h3 class="text-base font-semibold text-stone-900 mb-2">{c.name}</h3>
            {eb2 && (
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="text-stone-500 font-medium">EB-2 Final Action</span>
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold ${
                  eb2.data.finalActionDate === 'C' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                  eb2.data.finalActionDate === 'Unavailable' || eb2.data.finalActionDate === 'U' ? 'bg-amber-50 text-amber-800 border border-amber-200' :
                  'bg-stone-100 text-stone-800 border border-stone-200'
                }`}>
                  {eb2.data.finalActionDate === 'C' ? 'Current' : eb2.data.finalActionDate}
                </span>
              </div>
            )}
            <div class="mt-auto pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-[#1E3A5F]">
              <span>View all categories &amp; trends</span>
              <span>&rarr;</span>
            </div>
          </a>
        );
      })}
    </div>

    <h2 class="text-lg font-bold tracking-tight text-stone-800 mb-4 pb-2 border-b border-stone-100">{formattedMonth} — All Categories</h2>
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden mb-10">
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm whitespace-nowrap">
          <thead class="bg-stone-50/50 border-b border-stone-200">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Category</th>
              <th scope="col" class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Country</th>
              <th scope="col" class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Final Action Date</th>
              <th scope="col" class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Date for Filing</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {ebData.sort((a, b) => a.data.category.localeCompare(b.data.category) || a.data.country.localeCompare(b.data.country)).map((entry) => {
              const { category, country, finalActionDate, dateForFiling } = entry.data;
              return (
                <tr class="hover:bg-stone-50/50 transition-colors">
                  <td class="px-5 py-3.5 font-medium text-stone-900">{category}</td>
                  <td class="px-5 py-3.5 text-stone-600">
                    <a href={`/green-card/visa-bulletin/${bySlug(country)}`} class="hover:text-stone-900 underline font-medium">{country}</a>
                  </td>
                  <td class="px-5 py-3.5">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium ${
                      finalActionDate === 'C' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                      finalActionDate === 'Unavailable' || finalActionDate === 'U' ? 'bg-amber-50 text-amber-800 border border-amber-200' :
                      'bg-stone-100 text-stone-800 border border-stone-200'
                    }`}>
                      {finalActionDate === 'C' ? 'Current' : finalActionDate}
                    </span>
                  </td>
                  <td class="px-5 py-3.5">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium ${
                      dateForFiling === 'C' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                      dateForFiling === 'Unavailable' || dateForFiling === 'U' ? 'bg-amber-50 text-amber-800 border border-amber-200' :
                      'bg-stone-100 text-stone-800 border border-stone-200'
                    }`}>
                      {dateForFiling === 'C' ? 'Current' : dateForFiling}
                    </span>
                  </td>
                </tr>
              );
            })}
            {ebData.length === 0 && (
              <tr>
                <td colspan="4" class="px-5 py-4 text-center text-xs text-stone-500">No data available for this month.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Data Provenance Note -->
    <div class="bg-stone-50 rounded-lg p-5 text-xs text-stone-500 leading-relaxed">
      <span class="font-semibold text-stone-700">Data Guarantee:</span> Visa Bulletin cutoff dates are ingested monthly from official <a href="https://travel.state.gov/content/travel/en/legal/visa-law0/visa-bulletin.html" target="_blank" rel="noopener noreferrer" class="text-stone-700 font-medium underline hover:text-stone-900">U.S. Department of State Visa Bulletin</a> releases. Read our <a href="/how-we-verify" class="text-stone-700 font-medium underline hover:text-stone-900">verification standards</a>.
    </div>
  </div>
</Layout>
