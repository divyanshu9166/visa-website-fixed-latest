---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProcessingTimeTable from '../../components/ProcessingTimeTable.astro';
import ProcessingTimeChart from '../../components/ProcessingTimeChart.astro';
import ReceiptDatePredictor from '../../components/ReceiptDatePredictor.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import DisqusComments from '../../components/DisqusComments.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import StalenessWarning from '../../components/StalenessWarning.astro';

export async function getStaticPaths() {
  const forms = await getCollection('processingTimes');
  return forms.map((entry) => ({
    params: { visaSlug: entry.data.visaSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const f = entry.data;

const allForms = await getCollection('processingTimes');
const relatedEntries = f.relatedPages
  .map((href: string) => allForms.find((x) => `/uscis-processing-times/${x.data.visaSlug}` === href))
  .filter(Boolean);

const allCases = f.servicecenters.flatMap((sc) => sc.cases);
const minOfMin = Math.min(...allCases.map((c) => c.minMonths));
const maxOfMax = Math.max(...allCases.map((c) => c.maxMonths));

// Noindex pages still on seed data to protect YMYL accuracy trust signal
const shouldNoIndex = f.dataSource === 'seed';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'USCIS Processing Times', href: '/uscis-processing-times' },
  { label: f.visaLabel, href: `/uscis-processing-times/${f.visaSlug}` },
];

// JSON-LD: WebApplication (for the predictor tool) + Dataset
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: `${f.visaLabel} Processing Time Calculator`,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `USCIS Processing Times — ${f.visaLabel} (${f.formType})`,
    description: f.seoDesc,
    dateModified: f.lastUpdated,
    creator: { "@type": "Organization", name: "U.S. Citizenship and Immigration Services" },
    url: f.sourceUrl,
  },
];
---

<Layout title={f.seoTitle} description={f.seoDesc} breadcrumbs={breadcrumbs} noindex={shouldNoIndex}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'USCIS Processing Times', href: '/uscis-processing-times' },
      { label: f.visaLabel },
    ]} />

    <StalenessWarning
      lastUpdated={f.lastUpdated}
      staleSince={f.staleSince}
      maxAgeDays={2}
      sourceName="USCIS Case Processing Times"
      sourceUrl={f.sourceUrl || 'https://egov.uscis.gov/processing-times/'}
    />

    <div class="mb-10">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-stone-900 text-white text-xs font-semibold tracking-wide uppercase">{f.formType}</span>
        <StalenessWarning
          lastUpdated={f.lastUpdated}
          staleSince={f.staleSince}
          maxAgeDays={2}
          sourceName="USCIS.gov"
          mode="badge"
        />
        {f.dataSource === 'seed' && (
          <span class="inline-flex items-center text-xs font-medium text-amber-800 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-md" title="This build is using placeholder seed data.">
            Sample baseline data
          </span>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 mb-2">{f.seoTitle}</h1>
      <p class="text-base sm:text-lg text-stone-600">{f.formName}</p>
    </div>

    <!-- Calm Stat Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Overall Processing Range</p>
        <p class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900">{minOfMin}–{maxOfMax}<span class="text-sm font-normal text-stone-500"> months</span></p>
      </div>
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Service Centers</p>
        <p class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900">{f.servicecenters.length}</p>
      </div>
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Case Categories</p>
        <p class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900">{allCases.length}</p>
      </div>
    </div>

    <!-- Predictor Tool -->
    <div class="mb-12">
      <ReceiptDatePredictor servicecenters={f.servicecenters} />
    </div>

    <!-- Per service center tables + trend chart -->
    <div class="space-y-8 mb-12">
      {f.servicecenters.map((sc) => (
        <div>
          <ProcessingTimeTable centerName={sc.name} centerCode={sc.code} cases={sc.cases} />
          {sc.cases[0]?.history?.length > 1 && (
            <div class="mt-4">
              <ProcessingTimeChart
                title={`${sc.name} — "${sc.cases[0].caseType}" trend`}
                history={sc.cases[0].history.map((h: any) => ({ date: h.period + '-01', rangeLowMonths: h.min, rangeHighMonths: h.max }))}
              />
            </div>
          )}
        </div>
      ))}
    </div>

    {relatedEntries.length > 0 && (
      <div class="mb-12">
        <h2 class="text-base font-bold text-stone-900 mb-3">Related Visa Categories</h2>
        <div class="flex flex-wrap gap-2.5">
          {relatedEntries.map((r: any) => (
            <a href={`/uscis-processing-times/${r.data.visaSlug}`} class="px-3.5 py-1.5 rounded-lg bg-white border border-stone-200 text-xs font-medium text-stone-700 hover:border-stone-400 hover:text-stone-900 transition-colors">
              {r.data.visaLabel} &rarr;
            </a>
          ))}
          <a href="/uscis-stats/historic-trends" class="px-3.5 py-1.5 rounded-lg bg-stone-100 border border-stone-200 text-xs font-medium text-stone-800 hover:border-stone-400 transition-colors">
            Quarterly Workload Stats &rarr;
          </a>
        </div>
      </div>
    )}

    <!-- Data Provenance Note -->
    <div class="bg-stone-50 p-6 rounded-xl border border-stone-200 mb-8">
      <p class="text-xs sm:text-sm text-stone-700 leading-relaxed mb-3">{f.seoText}</p>
      <div class="pt-3 border-t border-stone-200 text-xs text-stone-500 leading-relaxed">
        <strong>Data Guarantee:</strong> Figures are ingested directly from official <a href="https://egov.uscis.gov/processing-times/" target="_blank" rel="noopener noreferrer" class="text-stone-700 font-medium underline hover:text-stone-900">USCIS Case Processing Times</a> publications. Read our <a href="/how-we-verify" class="text-stone-700 font-medium underline hover:text-stone-900">verification standards</a>.
      </div>
    </div>

    <FAQAccordion faqs={f.faqs} title={`${f.visaLabel} Processing FAQs`} />
    <div class="mt-8">
      <EmailCapture alertType="newsletter" label="Get Processing Time Updates" sublabel="We will notify you when USCIS updates processing times for this form." />
    </div>
    <DisqusComments pageIdentifier={`processing-${f.visaSlug}`} title={`${f.visaLabel} Processing Time Discussion`} />
  </div>
</Layout>
