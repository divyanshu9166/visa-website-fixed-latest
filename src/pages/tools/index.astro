---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const tools = [
  { href: '/tools/cap-gap-calculator', title: 'F-1 to H-1B Cap-Gap Calculator', desc: 'See exactly how cap-gap affects your F-1 status and work authorization, with a visual timeline.', badge: 'Utility' },
  { href: '/tools/h4-ead-extension-checker', title: 'H4 EAD Extension Checker', desc: 'Check if your H4 EAD renewal qualifies for the automatic work-authorization extension.', badge: 'Utility' },
  { href: '/tools/marriage-gc-fees', title: 'Marriage Green Card Fees', desc: 'Calculate exact total government filing fees for marriage-based adjustment of status under the latest rules.', badge: 'Fee Schedule' },
  { href: '/tools/premium-processing-roi', title: 'Premium Processing ROI', desc: 'Calculate if paying the $2,805 premium processing fee is financially worth it for your salary.', badge: null },
  { href: '/tools/h1b-lottery-calculator', title: 'H1B Lottery Odds Calculator', desc: 'Calculate your FY2027 H1B selection probability under the wage-weighted lottery rule.', badge: 'FY2027 Rules' },
  { href: '/tools/receipt-number-decoder', title: 'USCIS Receipt Number Decoder', desc: 'Decode your I-797 receipt number to find service center, fiscal year, and filing date.', badge: 'Decoder' },
  { href: '/tools/uscis-phone-calculator', title: 'USCIS Phone Navigator + N-400 Calculator', desc: 'Navigate the USCIS call center to a live agent. Plus: find your earliest N-400 filing date.', badge: null },
  { href: '/green-card/queue-calculator', title: 'Green Card Queue Calculator', desc: 'Estimate how many years until your priority date becomes current based on real USCIS inventory.', badge: 'Inventory Model' },
  { href: '/green-card/retrogression-tracker', title: 'Retrogression Tracker', desc: 'View historical months when priority dates moved backwards and by how much.', badge: 'Historical' },
  { href: '/green-card/visa-bulletin/hidden-checker', title: 'Hidden Visa Bulletin Checker', desc: "Check if the next month's Visa Bulletin has been published early on the DOS website.", badge: null },
  { href: '/visa-stats/consulate-refusal-rates', title: 'B1/B2 Consulate Refusal Rates', desc: 'See which countries have the highest and lowest visitor visa denial rates.', badge: 'DOS Records' },
];
---

<Layout title="US Immigration Calculators & Utilities — EasyVisaCheck" description="Free immigration calculators and tools: H1B lottery simulator, receipt number decoder, N-400 filing date calculator, and green card queue modeling.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />
    <div class="mt-4 mb-10 border-b border-stone-200 pb-6">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 mb-2">Immigration Tools &amp; Utilities</h1>
      <p class="text-base sm:text-lg text-stone-600 max-w-2xl">Objective calculators and decoders built to simplify official government filing rules without guesswork.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {tools.map(t => (
        <a href={t.href} class="bg-white border border-stone-200 rounded-xl p-5 hover:border-stone-400 transition-colors group flex flex-col h-full">
          <div class="flex items-start justify-between mb-2">
            <h2 class="text-base font-semibold text-stone-900 group-hover:text-stone-900">{t.title}</h2>
            {t.badge && (
              <span class="text-[10px] font-medium bg-stone-100 text-stone-700 border border-stone-200 px-2 py-0.5 rounded ml-2 flex-shrink-0">
                {t.badge}
              </span>
            )}
          </div>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-4">{t.desc}</p>
          <div class="mt-auto pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-[#1E3A5F]">
            <span>Open utility</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
