---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const faqs = [
  { q: "What is the proposed wage-weighted H1B lottery?", a: "Under the DHS proposed framework for FY2027, H1B cap registrations would be weighted based on the prevailing wage level offered on the certified Labor Condition Application (LCA). Level IV registrations receive higher selection weight than entry-level Level I registrations." },
  { q: "When does annual H1B cap registration occur?", a: "H1B cap registration typically opens in early March for approximately 14 days. USCIS announces exact registration window dates in late January or February." },
  { q: "Does the wage-weighting rule alter the registration fee?", a: "No. The $250 nonrefundable per-beneficiary USCIS registration fee remains uniform across all wage levels." },
  { q: "What occurs if the proposed wage rule is not finalized?", a: "If the proposed rule is delayed or set aside, USCIS conducts standard random computerized selection (the historical equal-probability model)." },
  { q: "How does the U.S. advanced degree exemption (Master's Cap) work?", a: "The Master's cap allocates an additional 20,000 visas for holders of qualifying U.S. advanced degrees. Beneficiaries not selected in the regular 65,000 cap enter a secondary drawing for the 20,000 Master's slots." },
  { q: "How is an applicant's prevailing wage level established?", a: "Wage levels (Levels I through IV) are determined based on Department of Labor (DOL) Occupational Employment Statistics (OES) benchmarks for the specific occupational code, duties, education requirements, and metropolitan area." }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---

<Layout
  title="H-1B Lottery Selection Model — FY2027 Wage-Weighted Analysis"
  description="Objective calculator modeling H-1B cap lottery selection probability under proposed DHS wage-level weighted rules and historical random baselines."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools' }, { label: 'H-1B Lottery Model' }]} />

    <div class="mt-4 mb-8 border-b border-stone-200 pb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-block bg-stone-100 text-stone-700 border border-stone-200 text-xs font-medium px-2.5 py-0.5 rounded">
          Regulatory Simulation Model
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 mb-2">H-1B Lottery Odds Calculator</h1>
      <p class="text-base sm:text-lg text-stone-600 max-w-2xl">Simulate selection probabilities under both the proposed DHS wage-level weighted model and the standard random selection baseline.</p>
    </div>

    <!-- Calculator Card -->
    <div class="bg-white border border-stone-200 rounded-xl p-6 sm:p-8 mb-8">
      <h2 class="text-base font-semibold text-stone-900 mb-5">Parameters</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
        <div>
          <label class="block text-xs font-semibold text-stone-700 uppercase tracking-wide mb-2">Wage Level (DOL OES Level)</label>
          <select id="wageLevel" class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 text-sm focus:ring-2 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] bg-white text-stone-900">
            <option value="1">Level I — Entry Level (&lt; 17th percentile)</option>
            <option value="2" selected>Level II — Qualified (&lt; 34th percentile)</option>
            <option value="3">Level III — Experienced (&lt; 50th percentile)</option>
            <option value="4">Level IV — Fully Competent (≥ 50th percentile)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone-700 uppercase tracking-wide mb-2">Statutory Cap Allocation</label>
          <select id="capType" class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 text-sm focus:ring-2 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] bg-white text-stone-900">
            <option value="regular">Regular Cap (65,000 slots)</option>
            <option value="masters">U.S. Advanced Degree Exemption (+20,000 slots)</option>
          </select>
        </div>
      </div>

      <div class="mb-6">
        <label class="block text-xs font-semibold text-stone-700 uppercase tracking-wide mb-2">Selection Framework</label>
        <div class="flex flex-wrap gap-4 text-xs sm:text-sm text-stone-800">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="fy" value="fy2027" checked class="text-[#1E3A5F] focus:ring-[#1E3A5F]">
            <span>Proposed Wage-Weighted Model</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="fy" value="fy2026" class="text-[#1E3A5F] focus:ring-[#1E3A5F]">
            <span>Standard Uniform Random Draw</span>
          </label>
        </div>
      </div>

      <button id="calcBtn" class="w-full sm:w-auto px-6 py-2.5 bg-[#1E3A5F] text-white font-medium text-sm rounded-lg hover:bg-[#152a45] transition-colors">
        Calculate Modeled Probability
      </button>
    </div>

    <!-- Results Card -->
    <div id="results" class="hidden bg-white border border-stone-200 rounded-xl p-6 sm:p-8 mb-8">
      <h2 class="text-base font-semibold text-stone-900 mb-4">Modeled Selection Outcome</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="text-center p-4 bg-stone-50 rounded-lg border border-stone-200">
          <div id="selectionChance" class="text-3xl font-bold text-stone-900 mb-1">—</div>
          <div class="text-xs text-stone-500 font-medium">Estimated Probability</div>
        </div>
        <div class="text-center p-4 bg-stone-50 rounded-lg border border-stone-200">
          <div id="wageMultiplier" class="text-3xl font-bold text-stone-900 mb-1">—</div>
          <div class="text-xs text-stone-500 font-medium">Relative Weight Factor</div>
        </div>
        <div class="text-center p-4 bg-stone-50 rounded-lg border border-stone-200">
          <div id="totalRegistrations" class="text-3xl font-bold text-stone-900 mb-1">~780K</div>
          <div class="text-xs text-stone-500 font-medium">Baseline Registrations</div>
        </div>
      </div>
      <div id="resultSummary" class="text-xs sm:text-sm text-stone-700 p-4 bg-stone-50 border border-stone-200 rounded-lg leading-relaxed"></div>
    </div>

    <!-- Wage Level Distribution Table -->
    <div class="bg-white border border-stone-200 rounded-xl overflow-hidden mb-8">
      <div class="px-5 py-4 border-b border-stone-200 bg-stone-50/50">
        <h2 class="text-sm font-semibold text-stone-900">Comparative Wage Level Selection Dynamics</h2>
        <p class="text-xs text-stone-500 mt-0.5">Mathematical distribution under proposed DHS weighting rules.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm whitespace-nowrap">
          <thead class="bg-white border-b border-stone-200">
            <tr>
              <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Wage Level</th>
              <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Weight</th>
              <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Pool Share</th>
              <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Modeled Selection Range</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <tr class="hover:bg-stone-50/50"><td class="px-5 py-3.5 font-medium text-stone-900">Level I (Entry)</td><td class="px-5 py-3.5 text-stone-600">1×</td><td class="px-5 py-3.5 text-stone-600">~35%</td><td class="px-5 py-3.5 text-stone-800 font-medium">~4–7%</td></tr>
            <tr class="hover:bg-stone-50/50"><td class="px-5 py-3.5 font-medium text-stone-900">Level II (Qualified)</td><td class="px-5 py-3.5 text-stone-600">2×</td><td class="px-5 py-3.5 text-stone-600">~40%</td><td class="px-5 py-3.5 text-stone-800 font-medium">~8–14%</td></tr>
            <tr class="hover:bg-stone-50/50"><td class="px-5 py-3.5 font-medium text-stone-900">Level III (Experienced)</td><td class="px-5 py-3.5 text-stone-600">4×</td><td class="px-5 py-3.5 text-stone-600">~18%</td><td class="px-5 py-3.5 text-stone-800 font-medium">~16–28%</td></tr>
            <tr class="hover:bg-stone-50/50"><td class="px-5 py-3.5 font-medium text-stone-900">Level IV (Fully Competent)</td><td class="px-5 py-3.5 text-stone-600">8×</td><td class="px-5 py-3.5 text-stone-600">~7%</td><td class="px-5 py-3.5 text-stone-800 font-medium">~32–55%</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Data Provenance Note -->
    <div class="bg-stone-50 rounded-lg p-5 text-xs text-stone-500 leading-relaxed mb-8">
      <span class="font-semibold text-stone-700">Methodology &amp; Legal Disclaimer:</span> These mathematical simulations model published regulatory proposals and historical USCIS cap registration volumes. Calculations do not constitute legal advice or guarantees of selection. Refer to official <a href="https://www.uscis.gov/working-in-the-united-states/temporary-workers/h-1b-specialty-occupations" target="_blank" rel="noopener noreferrer" class="text-stone-700 font-medium underline hover:text-stone-900">USCIS H-1B Program announcements</a> for official filing instructions.
    </div>

    <FAQAccordion faqs={faqs} title="H-1B Selection Process FAQs" />
  </div>
</Layout>

<script>
  const calcBtn = document.getElementById('calcBtn');
  const results = document.getElementById('results');

  const MULTIPLIERS = { '1': 1, '2': 2, '3': 4, '4': 8 };
  const DIST = { '1': 0.35, '2': 0.40, '3': 0.18, '4': 0.07 };
  const TOTAL_REGS = 780000;
  const CAP_REGULAR = 65000;
  const CAP_MASTERS = 20000;

  function calcOdds(wageLevel: string, capType: string, isFY2027: boolean) {
    const cap = capType === 'masters' ? (CAP_REGULAR + CAP_MASTERS) : CAP_REGULAR;
    const multiplier = MULTIPLIERS[wageLevel as keyof typeof MULTIPLIERS];

    if (!isFY2027) {
      const rate = Math.min(cap / TOTAL_REGS, 1.0);
      return { rate, multiplier: 1, label: 'Uniform random draw baseline' };
    }

    const weightedPool = Object.entries(DIST).reduce((sum, [lvl, pct]) => {
      return sum + (TOTAL_REGS * pct * MULTIPLIERS[lvl as keyof typeof MULTIPLIERS]);
    }, 0);

    const myWeight = multiplier;
    const rate = Math.min((cap / weightedPool) * myWeight, 1.0);
    return { rate, multiplier, label: `Level ${wageLevel} relative weight (${multiplier}×)` };
  }

  calcBtn?.addEventListener('click', () => {
    const wageLevel = (document.getElementById('wageLevel') as HTMLSelectElement).value;
    const capType = (document.getElementById('capType') as HTMLSelectElement).value;
    const isFY2027 = (document.querySelector('input[name="fy"]:checked') as HTMLInputElement).value === 'fy2027';

    const { rate, multiplier, label } = calcOdds(wageLevel, capType, isFY2027);
    const pct = (rate * 100).toFixed(1);

    const selEl = document.getElementById('selectionChance');
    const multEl = document.getElementById('wageMultiplier');
    const sumEl = document.getElementById('resultSummary');

    if (selEl) selEl.textContent = `${pct}%`;
    if (multEl) multEl.textContent = `${multiplier}×`;
    if (sumEl) {
      sumEl.innerHTML = `<strong>Simulation Summary:</strong> At DOL Wage Level ${wageLevel} under the ${isFY2027 ? 'proposed wage-weighted model' : 'uniform baseline'}, estimated selection probability is approximately <strong>${pct}%</strong> (${capType === 'masters' ? 'including Advanced Degree exemption' : 'Regular Cap allocation'}).`;
    }

    if (results) results.classList.remove('hidden');
  });
</script>
