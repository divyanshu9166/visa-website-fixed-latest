---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { BULLETIN_COUNTRIES, WAIT_TIME_COUNTRIES } from '../../scripts/lib/formsConfig.mjs';

const forms = await getCollection('processingTimes');

const searchIndex = [
  ...forms.map((f) => ({ label: `${f.data.visaLabel} (${f.data.formType})`, href: `/uscis-processing-times/${f.data.visaSlug}`, type: 'Processing Time' })),
  ...BULLETIN_COUNTRIES.map((c) => ({ label: `Visa Bulletin — ${c.name}`, href: `/green-card/visa-bulletin/${c.slug}`, type: 'Visa Bulletin' })),
  ...WAIT_TIME_COUNTRIES.map((c) => ({ label: `Appointment Wait Times — ${c.name}`, href: `/us-visa-appointment-wait-times/${c.slug}`, type: 'Wait Times' })),
  { label: 'Priority Date Calculator', href: '/green-card/priority-date-calculator', type: 'Tool' },
  { label: 'H1B Lottery Selection Estimator (FY2027)', href: '/tools/h1b-lottery-calculator', type: 'Tool' },
  { label: 'USCIS Receipt Number Decoder', href: '/tools/receipt-number-decoder', type: 'Tool' },
  { label: 'USCIS Phone Navigator + N-400 Calculator', href: '/tools/uscis-phone-calculator', type: 'Tool' },
  { label: 'Green Card Queue Calculator', href: '/green-card/queue-calculator', type: 'Tool' },
  { label: 'Retrogression Tracker', href: '/green-card/retrogression-tracker', type: 'Green Card' },
  { label: 'Hidden Visa Bulletin Checker', href: '/green-card/visa-bulletin/hidden-checker', type: 'Tool' },
  { label: 'H1B Sponsor & Salary Database', href: '/h1b', type: 'H1B' },
  { label: 'H1B Layoff Guide — 60-Day Grace Period', href: '/resources/h1b-layoff-guide', type: 'Resource' },
  { label: 'AC21 Job Portability Guide', href: '/resources/ac21-portability', type: 'Resource' },
  { label: 'How to Read the Visa Bulletin', href: '/resources/how-to-read-visa-bulletin', type: 'Resource' },
  { label: 'NVC Processing Times', href: '/uscis-processing-times/nvc', type: 'Processing Time' },
  { label: 'DOS Visa Bulletin Predictions', href: '/green-card/dos-predictions', type: 'Green Card' },
  { label: 'Green Card Statistics', href: '/green-card/gc-stats', type: 'Green Card' },
  { label: 'Nonimmigrant Visa Statistics (F1, B1B2)', href: '/visa-stats', type: 'Statistics' },
  { label: 'Slot Screenshots — Community Shared', href: '/trackers/slot-screenshots', type: 'Tracker' },
  { label: 'Blog — Immigration Guides', href: '/blog', type: 'Blog' },
  { label: 'Prediction Accuracy Backtest', href: '/green-card/prediction-accuracy', type: 'Green Card' },
  { label: 'How We Verify Our Data', href: '/how-we-verify', type: 'Trust' },
];

const faqs = [
  {
    question: "How accurate are USCIS processing times?",
    answer: "USCIS processing times are estimates based on historical data. They represent the time it took to complete 80% of adjudicated cases over the past six months. While helpful for benchmarking, individual cases may fall outside these ranges due to background checks, requests for evidence (RFE), or administrative delays."
  },
  {
    question: "When does the Visa Bulletin update?",
    answer: "The US State Department typically publishes the Visa Bulletin between the 8th and 15th of each month. It provides the priority dates for the upcoming month, determining who can submit their I-485 Adjustment of Status applications or receive final green card approval."
  },
  {
    question: "What is the difference between Final Action Dates and Dates for Filing?",
    answer: "Final Action Dates indicate when a green card can actually be approved and issued. Dates for Filing indicate when applicants living in the US can submit their I-485 applications to USCIS. USCIS announces each month which chart applicants must use."
  },
  {
    question: "Why is the H1B to Green Card wait so long for Indian nationals?",
    answer: "US immigration law limits any single country to no more than 7% of the total employment-based green cards issued each year. Because there are significantly more applicants from India than the annual cap allows, a massive backlog has accumulated, leading to wait times that can span decades for EB-2 and EB-3 categories."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout title="Track US Visa & Immigration Processing Times" description="Check the latest USCIS processing times and State Department Visa Bulletin dates for H1B, Green Card, and Citizenship applications. Verified official government data, updated daily.">

	<!-- JSON-LD FAQ Schema -->
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<!-- Hero: Calm, Reassuring -->
