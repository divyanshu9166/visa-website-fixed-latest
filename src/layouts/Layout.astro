---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	breadcrumbs?: { label: string; href: string }[];
	/** Set to "article" for blog posts; defaults to "website" */
	ogType?: string;
	/** ISO date string for article:published_time */
	publishDate?: string;
	/** Article author name */
	author?: string;
	/** Override the default canonical URL (absolute URL) */
	canonical?: string;
	/** If true, adds <meta name="robots" content="noindex,follow"> */
	noindex?: boolean;
}

const {
	title,
	description = "Track US Visa & Immigration Processing Times with verified official government data.",
	breadcrumbs,
	ogType = "website",
	publishDate,
	author,
	canonical,
	noindex = false,
} = Astro.props;

const SITE = Astro.site?.toString().replace(/\/$/, '') || 'https://easyvisacheck.com';
const canonicalURL = canonical || new URL(Astro.url.pathname, SITE).href;

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.label,
    item: b.href.startsWith('http') ? b.href : `https://easyvisacheck.com${b.href}`
  }))
} : null;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-TMKXXYBY5Y"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-TMKXXYBY5Y');
		</script>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalURL} />

		{noindex && <meta name="robots" content="noindex,follow" />}

		<!-- Open Graph / Social Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={`${SITE}/logo-black.png`} />
		<meta property="og:site_name" content="EasyVisaCheck" />
		<meta property="og:locale" content="en_US" />

		{ogType === "article" && publishDate && (
			<meta property="article:published_time" content={publishDate} />
		)}
		{ogType === "article" && author && (
			<meta property="article:author" content={author} />
		)}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${SITE}/logo-black.png`} />

		<!-- BreadcrumbList Schema (when breadcrumbs provided) -->
		{breadcrumbSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		)}

		<!-- Google AdSense -->
		<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8372328308593046" crossorigin="anonymous" onerror="console.warn('Ad blocker detected or DNS resolution failed for AdSense');"></script>
	</head>
	<body class="bg-[#FBFBF9] text-stone-900 font-sans antialiased min-h-screen flex flex-col selection:bg-stone-200 selection:text-stone-900 leading-relaxed">
		<header class="bg-[#FBFBF9]/90 backdrop-blur-md border-b border-stone-200 sticky top-0 z-20 transition-colors">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center py-2.5 min-h-[4.5rem]">
					<!-- Logo -->
					<div class="flex-shrink-0 flex items-center lg:w-48">
						<a href="/" class="flex items-center gap-2 font-bold tracking-tight text-stone-900 hover:opacity-80 transition-opacity">
							<img src="/logo-black.png" alt="EasyVisaCheck Logo" class="h-16 w-auto object-contain scale-125 origin-left" />
						</a>
					</div>

					<!-- Centered Navigation with calm styling -->
					<nav class="hidden lg:flex flex-1 justify-center space-x-1 items-center">
						<a href="/uscis-processing-times" class="text-stone-600 hover:text-stone-950 px-3 py-2 rounded-md text-sm font-medium transition-colors">Processing Times</a>
						<a href="/green-card/visa-bulletin" class="text-stone-600 hover:text-stone-950 px-3 py-2 rounded-md text-sm font-medium transition-colors">Visa Bulletin</a>
						<a href="/us-visa-appointment-wait-times" class="text-stone-600 hover:text-stone-950 px-3 py-2 rounded-md text-sm font-medium transition-colors">Wait Times</a>
						<a href="/h1b" class="text-stone-600 hover:text-stone-950 px-3 py-2 rounded-md text-sm font-medium transition-colors">H-1B Sponsors</a>
						<a href="/tools" class="text-stone-600 hover:text-stone-950 px-3 py-2 rounded-md text-sm font-medium transition-colors">Tools</a>
						<a href="/blog" class="text-stone-600 hover:text-stone-950 px-3 py-2 rounded-md text-sm font-medium transition-colors">Guides</a>
						<a href="/how-we-verify" class="text-teal-800 hover:text-teal-950 px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-1.5">
							<svg class="w-3.5 h-3.5 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
							How We Verify
						</a>
					</nav>

					<!-- Right Side: Auth & Mobile Menu -->
					<div class="flex items-center justify-end lg:w-48 gap-3">
						<a href="/login" id="nav-auth-link" class="hidden md:inline-flex text-stone-800 px-3.5 py-1.5 rounded-md text-sm font-medium border border-stone-300 hover:bg-stone-100 transition-colors">Sign In</a>
						<button id="mobile-menu-btn" class="lg:hidden p-2.5 rounded-md text-stone-700 hover:bg-stone-100 min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Open menu" aria-expanded="false">
							<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
						</button>
					</div>
				</div>
			</div>
			<nav id="mobile-menu" class="hidden md:hidden border-t border-stone-200 bg-[#FBFBF9]">
				<div class="px-4 py-3 flex flex-col space-y-1.5">
					<a href="/uscis-processing-times" class="text-stone-700 hover:text-stone-950 px-3 py-2.5 rounded-md text-sm font-medium">Processing Times</a>
					<a href="/green-card/visa-bulletin" class="text-stone-700 hover:text-stone-950 px-3 py-2.5 rounded-md text-sm font-medium">Visa Bulletin</a>
					<a href="/us-visa-appointment-wait-times" class="text-stone-700 hover:text-stone-950 px-3 py-2.5 rounded-md text-sm font-medium">Appointment Wait Times</a>
					<a href="/h1b" class="text-stone-700 hover:text-stone-950 px-3 py-2.5 rounded-md text-sm font-medium">H-1B Sponsor Database</a>
					<a href="/tools" class="text-stone-700 hover:text-stone-950 px-3 py-2.5 rounded-md text-sm font-medium">Free Calculators & Tools</a>
					<a href="/how-we-verify" class="text-teal-800 font-semibold px-3 py-2.5 rounded-md text-sm flex items-center gap-2">
						<svg class="w-4 h-4 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
						How We Verify Our Data
					</a>
					<a href="/blog" class="text-stone-700 hover:text-stone-950 px-3 py-2.5 rounded-md text-sm font-medium">Guides & Analysis</a>
					<a href="/login" class="text-stone-900 hover:text-stone-950 px-3 py-2.5 rounded-md text-sm font-semibold">Sign In</a>
					<a href="/about-us" class="text-stone-500 hover:text-stone-900 px-3 py-2 rounded-md text-sm">About EasyVisaCheck</a>
					<a href="/contact-us" class="text-stone-500 hover:text-stone-900 px-3 py-2 rounded-md text-sm">Contact</a>
				</div>
			</nav>
		</header>

		<script>
			const btn = document.getElementById('mobile-menu-btn');
			const menu = document.getElementById('mobile-menu');
			btn?.addEventListener('click', () => {
				const isHidden = menu?.classList.contains('hidden');
				menu?.classList.toggle('hidden');
				btn.setAttribute('aria-expanded', String(!!isHidden));
			});
		</script>

		<script>
			import { getSession } from '../lib/auth';
			const navAuthLink = document.getElementById('nav-auth-link') as HTMLAnchorElement | null;
			if (navAuthLink) {
				getSession().then((user) => {
					if (user) {
						navAuthLink.textContent = 'Dashboard';
						navAuthLink.href = '/dashboard';
					}
				}).catch(() => {});
			}
		</script>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-[#F6F6F2] mt-16 py-12 border-t border-stone-200">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
				<a href="/" class="inline-block">
					<img src="/logo-black.png" alt="EasyVisaCheck Logo" class="h-16 w-auto object-contain scale-125 origin-left opacity-90 hover:opacity-100 transition-opacity" />
				</a>
			</div>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-5 gap-8 mb-10">
				<div>
					<h4 class="text-xs font-semibold text-stone-900 uppercase tracking-wider mb-3">Processing Times</h4>
					<ul class="space-y-2 text-sm text-stone-600">
						<li><a href="/uscis-processing-times/h1b-visa" class="hover:text-stone-900">H-1B Visa</a></li>
						<li><a href="/uscis-processing-times/i-140" class="hover:text-stone-900">I-140 Immigrant Petition</a></li>
						<li><a href="/uscis-processing-times/i-485-eb" class="hover:text-stone-900">I-485 Green Card (EB)</a></li>
						<li><a href="/uscis-processing-times/n-400" class="hover:text-stone-900">N-400 Citizenship</a></li>
						<li><a href="/uscis-processing-times/nvc" class="hover:text-stone-900">NVC Processing</a></li>
						<li><a href="/uscis-processing-times" class="hover:text-stone-900">All 14+ Visas &rarr;</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-xs font-semibold text-stone-900 uppercase tracking-wider mb-3">Green Card</h4>
					<ul class="space-y-2 text-sm text-stone-600">
						<li><a href="/green-card/visa-bulletin/india" class="hover:text-stone-900">Visa Bulletin — India</a></li>
						<li><a href="/green-card/visa-bulletin/china" class="hover:text-stone-900">Visa Bulletin — China</a></li>
						<li><a href="/green-card/marriage-gc-timeline" class="hover:text-stone-900">Marriage GC Timeline</a></li>
						<li><a href="/green-card/queue-calculator" class="hover:text-stone-900">Queue Calculator</a></li>
						<li><a href="/green-card/retrogression-tracker" class="hover:text-stone-900">Retrogression Tracker</a></li>
						<li><a href="/green-card/gc-stats" class="hover:text-stone-900">Quarterly GC Stats</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-xs font-semibold text-stone-900 uppercase tracking-wider mb-3">H-1B & Tools</h4>
					<ul class="space-y-2 text-sm text-stone-600">
						<li><a href="/h1b" class="hover:text-stone-900">H-1B Sponsor Database</a></li>
						<li><a href="/tools/h1b-lottery-calculator" class="hover:text-stone-900">Lottery Selection Estimator</a></li>
						<li><a href="/tools/cap-gap-calculator" class="hover:text-stone-900">F-1 Cap-Gap Calculator</a></li>
						<li><a href="/tools/h4-ead-extension-checker" class="hover:text-stone-900">H4 EAD Auto-Extension</a></li>
						<li><a href="/tools/receipt-number-decoder" class="hover:text-stone-900">Receipt Number Decoder</a></li>
						<li><a href="/tools" class="hover:text-stone-900">All Calculators &rarr;</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-xs font-semibold text-stone-900 uppercase tracking-wider mb-3">Appointments</h4>
					<ul class="space-y-2 text-sm text-stone-600">
						<li><a href="/us-visa-appointment-wait-times/india" class="hover:text-stone-900">India Consulates</a></li>
						<li><a href="/us-visa-appointment-wait-times/mexico" class="hover:text-stone-900">Mexico Consulates</a></li>
						<li><a href="/us-visa-appointment-wait-times/canada" class="hover:text-stone-900">Canada Consulates</a></li>
						<li><a href="/us-visa-appointment-wait-times" class="hover:text-stone-900">All Global Posts &rarr;</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-xs font-semibold text-stone-900 uppercase tracking-wider mb-3">Trust & Ethics</h4>
					<ul class="space-y-2 text-sm text-stone-600">
						<li><a href="/how-we-verify" class="font-medium text-teal-800 hover:text-teal-950">How We Verify Data</a></li>
						<li><a href="/about-us" class="hover:text-stone-900">About Our Mission</a></li>
						<li><a href="/contact-us" class="hover:text-stone-900">Contact & Feedback</a></li>
						<li><a href="/blog" class="hover:text-stone-900">Immigration Guides</a></li>
					</ul>
				</div>
			</div>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-start md:items-center text-sm border-t border-stone-200 pt-8 gap-4">
				<div class="text-left">
					<p class="mb-1 font-medium text-stone-800">EasyVisaCheck is an independent informational resource and is not affiliated with USCIS, DHS, or the US Department of State.</p>
					<p class="text-stone-500 max-w-2xl text-xs">Data is aggregated directly from official public government publications (egov.uscis.gov, travel.state.gov, and dol.gov). For official case status and legal determinations, always consult your attorney and official government portals. Read our <a href="/how-we-verify" class="underline text-teal-800 hover:text-teal-950">Data Verification Standards</a>.</p>
				</div>
				<div class="text-stone-400 text-xs whitespace-nowrap self-start md:self-center">
					&copy; {new Date().getFullYear()} EasyVisaCheck.
				</div>
			</div>
		</footer>
	</body>
</html>
