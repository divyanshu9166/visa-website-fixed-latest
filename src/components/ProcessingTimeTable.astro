---
import DualTerminology from './DualTerminology.astro';

interface CaseTypeEntry {
  caseType: string;
  minMonths: number;
  maxMonths: number;
  serviceRequestDate: string | null;
  history: { period: string; min: number; max: number }[];
}

interface Props {
  centerName: string;
  centerCode: string;
  cases: CaseTypeEntry[];
}

const { centerName, centerCode, cases } = Astro.props;

function trend(c: CaseTypeEntry) {
  if (c.history.length < 2) return null;
  const prev = c.history[c.history.length - 2];
  const diff = c.maxMonths - prev.max;
  if (Math.abs(diff) < 0.15) return { label: 'Stable', cls: 'bg-stone-100 text-stone-700 border border-stone-200' };
  // Genuine advancement
  if (diff < 0) return { label: 'Improving', cls: 'bg-emerald-50 text-emerald-700 border border-emerald-200' };
  // Stagnant/Delays
  return { label: 'Extended', cls: 'bg-amber-50 text-amber-800 border border-amber-200' };
}

function formatDate(d: string | null) {
  if (!d) return '—';
  try {
    return new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
  } catch {
    return d;
  }
}
---

<div class="bg-white rounded-xl border border-stone-200 overflow-hidden mb-8">
  <div class="px-5 py-4 border-b border-stone-200 flex items-center justify-between bg-stone-50/50">
    <h3 class="font-semibold text-stone-900 text-lg tracking-tight">{centerName}</h3>
    <span class="inline-flex items-center justify-center min-w-[3rem] px-2.5 py-1 rounded-md text-[10px] uppercase font-bold bg-white border border-stone-300 text-stone-700 shadow-sm">{centerCode}</span>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full text-left text-sm whitespace-nowrap">
      <thead class="bg-white border-b border-stone-200">
        <tr>
          <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Case Category</th>
          <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">80% Processed In</th>
          <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide">Service Request Date</th>
          <th class="px-5 py-3 font-semibold text-stone-800 text-xs tracking-wide text-right">30-Day Trend</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        {cases.map((c) => {
          const t = trend(c);
          return (
            <tr class="hover:bg-stone-50/50 transition-colors">
              <td class="px-5 py-3.5 align-top whitespace-normal min-w-[250px]">
                <DualTerminology term={c.caseType} class="w-full" />
              </td>
              <td class="px-5 py-3.5 align-top">
                <span class="bg-stone-100 border border-stone-200 text-stone-800 font-medium px-2.5 py-1 rounded whitespace-nowrap">
                  {c.minMonths} – {c.maxMonths} months
                </span>
              </td>
              <td class="px-5 py-3.5 align-top">
                <span class="text-stone-600">{formatDate(c.serviceRequestDate)}</span>
              </td>
              <td class="px-5 py-3.5 align-top text-right">
                {t && <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${t.cls}`}>{t.label}</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  {cases[0]?.serviceRequestDate && (
    <div class="px-5 py-3.5 bg-stone-50 border-t border-stone-200 text-xs text-stone-600 leading-relaxed">
      <strong>Inquiry Eligibility:</strong> If USCIS received your case on or before the <em>Service Request Date</em> shown above, you are eligible to submit an official <span class="font-medium text-stone-800">e-Request</span> for cases outside normal processing times.
    </div>
  )}
</div>
