---
interface Props {
  lastUpdated?: string | null;
  staleSince?: string | null;
  maxAgeDays?: number;
  sourceName?: string;
  sourceUrl?: string;
  mode?: 'banner' | 'badge' | 'card-footer';
  isLiveValidated?: boolean;
}

const {
  lastUpdated,
  staleSince,
  maxAgeDays = 2,
  sourceName = 'Official Government Source',
  sourceUrl,
  mode = 'banner',
  isLiveValidated = true,
} = Astro.props;

let isStale = false;
let verifiedDateStr = lastUpdated || '';

if (staleSince) {
  const staleTime = new Date(staleSince).getTime();
  const daysDiff = (Date.now() - staleTime) / (1000 * 60 * 60 * 24);
  if (daysDiff >= maxAgeDays) {
    isStale = true;
  }
} else if (lastUpdated) {
  const updatedTime = new Date(lastUpdated).getTime();
  if (!isNaN(updatedTime)) {
    // Upstream government releases publish periodically. Flag if no publication in >60 days.
    const daysDiff = (Date.now() - updatedTime) / (1000 * 60 * 60 * 24);
    if (daysDiff >= Math.max(maxAgeDays, 60)) {
      isStale = true;
    }
  }
}

if (verifiedDateStr) {
  try {
    const d = new Date(verifiedDateStr);
    if (!isNaN(d.getTime())) {
      verifiedDateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }
  } catch {}
}
---

{mode === 'banner' && isStale && (
  <aside class="mb-6 rounded-lg border border-amber-300/80 bg-amber-50/90 p-4 text-amber-950" role="status" aria-label="Data Freshness Notice">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-amber-700 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div class="text-xs sm:text-sm">
        <p class="font-semibold text-amber-950">Upstream Synchronization Notice</p>
        <p class="mt-0.5 text-amber-900 leading-relaxed">
          Daily live synchronization with {sourceName} was delayed upstream. Displaying last confirmed government records
          {verifiedDateStr ? ` from ${verifiedDateStr}` : ''}.
          {sourceUrl && (
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="ml-1 underline font-medium text-amber-950 hover:text-stone-900">
              Cross-verify directly on {sourceName} &rarr;
            </a>
          )}
        </p>
      </div>
    </div>
  </aside>
)}

{mode === 'badge' && (
  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-stone-100 text-stone-700 border border-stone-200">
    <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
    <span>{isStale ? `Preserved snapshot: ${verifiedDateStr}` : `Verified official data: ${verifiedDateStr || 'Current'}`}</span>
  </div>
)}

{mode === 'card-footer' && (
  <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
      <span>Verified {verifiedDateStr || 'Official Data'}</span>
    </span>
    {sourceUrl ? (
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="text-stone-500 hover:text-stone-800 underline">
        Source
      </a>
    ) : (
      <span>{sourceName}</span>
    )}
  </div>
)}
