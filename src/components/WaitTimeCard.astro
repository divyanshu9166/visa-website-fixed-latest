---
interface Props {
  country: string;
  slug: string;
  countryCode: string;
  fastest: number | null;
  slowest: number | null;
}

const { country, slug, countryCode, fastest, slowest } = Astro.props;

function badge(days: number | null) {
  if (days === null) return { cls: 'bg-stone-100 text-stone-700 border border-stone-200', label: 'N/A' };
  if (days < 60) return { cls: 'bg-emerald-50 text-emerald-800 border border-emerald-200', label: `${days}d` };
  if (days < 180) return { cls: 'bg-stone-100 text-stone-800 border border-stone-200', label: `${days}d` };
  return { cls: 'bg-amber-50 text-amber-900 border border-amber-200', label: `${days}d` };
}

const b = badge(fastest);

function flagEmoji(cc: string) {
  if (!cc || cc.length !== 2) return '🌐';
  return String.fromCodePoint(...[...cc.toUpperCase()].map((c) => 127397 + c.charCodeAt(0)));
}
---

<a href={`/us-visa-appointment-wait-times/${slug}`} class="block bg-white border border-stone-200 rounded-xl p-5 hover:border-stone-400 group transition-colors flex flex-col h-full">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2.5">
      <span class="text-xl" aria-hidden="true">{flagEmoji(countryCode)}</span>
      <h3 class="font-semibold text-stone-900 text-base">{country}</h3>
    </div>
  </div>
  <div class="flex items-center justify-between text-xs mb-1.5">
    <span class="text-stone-500 font-medium">Fastest visitor wait</span>
    <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold ${b.cls}`}>{b.label}</span>
  </div>
  {slowest !== null && slowest !== fastest && (
    <div class="flex items-center justify-between text-xs text-stone-500">
      <span>Slowest post</span>
      <span class="text-stone-700 font-medium">{slowest}d</span>
    </div>
  )}
  <div class="mt-auto pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-[#1E3A5F]">
    <span>View consulates</span>
    <span>&rarr;</span>
  </div>
</a>
