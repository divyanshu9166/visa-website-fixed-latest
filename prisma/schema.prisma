// ============================================================================
// US Visa Tracker — Prisma schema (Phase 2 community trackers + auth)
// ============================================================================
// Uses Prisma Postgres (https://www.prisma.io/postgres) — a managed Postgres
// with built-in connection pooling and native edge-runtime support, so this
// works directly from Cloudflare Pages Functions with no separate driver
// adapter and no "cold database" wake-up delay. See README.md for the full
// setup guide.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (custom — no third-party auth provider, just this app + Postgres)
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions         Session[]
  h1bCases         H1bCase[]
  i485Cases        I485Case[]
  dropboxCases     DropboxCase[]
  rescheduleCases  RescheduleCase[]
  cases221g        Case221g[]
  emergencyCases   EmergencyCase[]

  @@map("users")
}

// Opaque-token, database-backed sessions (no JWT secret to manage/rotate).
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// H-1B cases
// ---------------------------------------------------------------------------
model H1bCase {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fiscalYear         Int       @map("fiscal_year")
  petitionType       String    @map("petition_type")
  quotaType          String?   @map("quota_type")
  registrationStatus String?   @map("registration_status")
  registrationDate   DateTime? @map("registration_date")
  receiptNumber      String?   @map("receipt_number")
  caseStatus         String    @default("Pending") @map("case_status")
  caseStatusDate     DateTime? @map("case_status_date")
  serviceCenter      String?   @map("service_center")
  premiumProcessing  Boolean   @default(false) @map("premium_processing")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([fiscalYear])
  @@map("h1b_cases")
}

// ---------------------------------------------------------------------------
// I-485 cases
// ---------------------------------------------------------------------------
model I485Case {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          String
  countryOfBirth    String?   @map("country_of_birth")
  priorityDate      DateTime? @map("priority_date")
  filingDate        DateTime? @map("filing_date")
  serviceCenter     String?   @map("service_center")
  caseStatus        String    @default("Filed") @map("case_status")
  caseStatusDate    DateTime? @map("case_status_date")
  eadReceived       Boolean   @default(false) @map("ead_received")
  travelDocReceived Boolean   @default(false) @map("travel_doc_received")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("i485_cases")
}

// ---------------------------------------------------------------------------
// Drop box / interview waiver cases
// ---------------------------------------------------------------------------
model DropboxCase {
  id                       String    @id @default(uuid())
  userId                   String    @map("user_id")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visaType                 String    @map("visa_type")
  consulate                String
  eligibilitySubmittedDate DateTime? @map("eligibility_submitted_date")
  dropboxDate              DateTime? @map("dropbox_date")
  outcome                  String    @default("Pending")
  daysWaited               Int?      @map("days_waited")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("dropbox_cases")
}

// ---------------------------------------------------------------------------
// Consulate reschedule cases
// ---------------------------------------------------------------------------
model RescheduleCase {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consulate               String
  originalAppointmentDate DateTime? @map("original_appointment_date")
  rescheduledDate         DateTime? @map("rescheduled_date")
  reason                  String?
  success                 Boolean   @default(false)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("consulate_reschedule_cases")
}

// ---------------------------------------------------------------------------
// 221(g) administrative processing cases
// ---------------------------------------------------------------------------
model Case221g {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visaType             String    @map("visa_type")
  consulate            String
  dateIssued           DateTime? @map("date_issued")
  documentsRequested   String?   @map("documents_requested")
  resolutionStatus     String    @default("Pending") @map("resolution_status")
  daysToResolve        Int?      @map("days_to_resolve")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("cases_221g")
}

// ---------------------------------------------------------------------------
// Emergency appointment requests
// ---------------------------------------------------------------------------
model EmergencyCase {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visaType                String    @map("visa_type")
  consulate               String
  requestReason           String?   @map("request_reason")
  requestDate             DateTime? @map("request_date")
  outcome                 String    @default("Pending")
  appointmentGrantedDate  DateTime? @map("appointment_granted_date")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("emergency_appointment_cases")
}

// ---------------------------------------------------------------------------
// Case confirmations ("similar to mine" community endorsements)
// ---------------------------------------------------------------------------
model CaseConfirmation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  caseTable String   @map("case_table")   // e.g. "h1b_cases"
  caseId    String   @map("case_id")       // the case row's id
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, caseTable, caseId])    // one confirmation per user per case
  @@index([caseTable, caseId])
  @@map("case_confirmations")
}

// ---------------------------------------------------------------------------
// Email alert subscriptions
// ---------------------------------------------------------------------------
model EmailSubscription {
  id        String   @id @default(uuid())
  email     String
  alertType String   @map("alert_type")   // "visa_bulletin" | "slot_alert" | "newsletter"
  metadata  String?                        // JSON: { category, country, consulate, visaType }
  confirmed Boolean  @default(false)
  token     String   @unique @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, alertType])
  @@index([alertType])
  @@map("email_subscriptions")
}

// ---------------------------------------------------------------------------
// Slot screenshots (crowdsourced)
// ---------------------------------------------------------------------------
model SlotScreenshot {
  id          String   @id @default(uuid())
  consulate   String
  visaType    String   @map("visa_type")
  slotDate    DateTime? @map("slot_date")
  imageUrl    String   @map("image_url")
  notes       String?
  upvotes     Int      @default(0)
  submittedBy String?  @map("submitted_by")   // anonymous or email
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([consulate])
  @@index([visaType])
  @@map("slot_screenshots")
}

// ---------------------------------------------------------------------------
// LCA Employers DB
// ---------------------------------------------------------------------------
model LcaEmployer {
  id           String   @id @default(uuid())
  employerName String   @map("employer_name") @unique
  slug         String   @unique
  totalLCAs    Int      @map("total_lcas")
  approvalRate Float    @map("approval_rate")
  avgWage      Int      @map("avg_wage")
  medianWage   Int      @map("median_wage")
  topTitles    Json     @map("top_titles") // [{ title, count, avgWage, socCode }]
  topStates    Json     @map("top_states") // [{ state, count }]
  wageLevelDist Json    @map("wage_level_dist") // { L1, L2, L3, L4 }
  fiscalYear   Int      @map("fiscal_year")
  grade        String
  lastUpdated  DateTime @map("last_updated")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@map("lca_employers")
}

// ---------------------------------------------------------------------------
// LCA Employer Quarterly Longitudinal Records
// ---------------------------------------------------------------------------
model LcaEmployerQuarterly {
  id            String   @id @default(uuid())
  slug          String
  employerName  String   @map("employer_name")
  fiscalYear    Int      @map("fiscal_year")
  quarter       Int
  totalLCAs     Int      @map("total_lcas")
  approvalRate  Float    @map("approval_rate")
  avgWage       Int      @map("avg_wage")
  medianWage    Int      @map("median_wage")
  topTitles     Json     @map("top_titles")
  topStates     Json     @map("top_states")
  wageLevelDist Json     @map("wage_level_dist")
  grade         String
  importedAt    DateTime @default(now()) @map("imported_at")

  @@unique([slug, fiscalYear, quarter])
  @@index([slug])
  @@index([fiscalYear, quarter])
  @@map("lca_employer_quarterly")
}

// ---------------------------------------------------------------------------
// Government Data Longitudinal Archive (SCD Type 2 persistent historical ledger)
// ---------------------------------------------------------------------------
model GovernmentDataArchive {
  id         String   @id @default(uuid())
  domain     String   // "PROCESSING_TIME" | "VISA_BULLETIN" | "WAIT_TIME" | "USCIS_STATS"
  entityKey  String   @map("entity_key") // e.g. "I-485-nebraska", "EB2-India", "india-mumbai", "I-140"
  period     String   // e.g. "2026-09", "FY2026-Q2"
  metrics    Json     // Full snapshot payload
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@unique([domain, entityKey, period])
  @@index([domain, entityKey])
  @@index([period])
  @@map("government_data_archive")
}

